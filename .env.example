# ─── App ───────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000

# ─── Security ──────────────────────────────────────────
# Internal API key — NestJS gateway must send this in every request
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENGINE_API_KEY=generate_a_strong_random_key_here

# ─── AWS ───────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET_NAME=id-verification-uploads-yourname

# ─── Scoring thresholds ────────────────────────────────
FACE_SIMILARITY_THRESHOLD=70.0   # minimum face score to be considered a match
LIVENESS_THRESHOLD=70.0          # minimum liveness score to be considered live
COMPOSITE_PASS_THRESHOLD=80.0    # minimum composite score to pass